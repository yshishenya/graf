{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2brain.dev/contracts/leakage-finalization-events.schema.json",
  "title": "Leakage Finalization Metadata Events",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventName",
    "occurredAt",
    "sessionId",
    "directoryId",
    "diagnosticSafe",
    "externalEgressStarted"
  ],
  "properties": {
    "schemaVersion": {
      "const": "leakage-finalization-events.v1"
    },
    "eventName": {
      "enum": [
        "leakage_finalization_started",
        "leakage_finalization_completed",
        "leakage_finalization_unproven",
        "leakage_finalization_not_measured",
        "leakage_detected",
        "derived_cleaned_track_created",
        "derived_cleaned_track_validated"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "directoryId": {
      "type": "string",
      "minLength": 1
    },
    "diagnosticSafe": {
      "const": true
    },
    "externalEgressStarted": {
      "const": false
    },
    "leakageStatus": {
      "enum": [
        "clean",
        "leakage_detected",
        "unproven",
        "not_measured",
        "not_applicable"
      ]
    },
    "thresholdVersion": {
      "type": "string"
    },
    "failureReason": {
      "type": "string"
    },
    "transcriptionGate": {
      "type": "string"
    },
    "derivedTrackId": {
      "type": "string"
    },
    "sourceTrackIds": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "not": {
    "anyOf": [
      { "required": ["rawAudio"] },
      { "required": ["audioSnippet"] },
      { "required": ["transcriptText"] },
      { "required": ["meetingContent"] },
      { "required": ["participantSpeech"] },
      { "required": ["credentials"] },
      { "required": ["apiKey"] },
      { "required": ["tokens"] },
      { "required": ["signedUrls"] },
      { "required": ["password"] },
      { "required": ["absolutePath"] },
      { "required": ["liveSecretPath"] }
    ]
  }
}
