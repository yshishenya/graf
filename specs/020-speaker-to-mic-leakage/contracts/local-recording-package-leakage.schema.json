{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2brain.dev/contracts/local-recording-package-leakage.schema.json",
  "title": "Local Recording Package Leakage Finalization",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "directoryId",
    "status",
    "transcriptionReadiness",
    "mediaScribeSourceMode",
    "externalEgressStarted",
    "transcriptionStarted",
    "diagnosticSafe",
    "tracks",
    "leakageFinalization"
  ],
  "properties": {
    "schemaVersion": {
      "const": "local-recording-manifest.v3"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "directoryId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["saved", "degraded", "failed"]
    },
    "transcriptionReadiness": {
      "enum": ["ready", "degraded", "failed", "legacy_not_ready"]
    },
    "mediaScribeSourceMode": {
      "enum": ["dual", "derived_dual", "mixed", "none"]
    },
    "externalEgressStarted": {
      "const": false
    },
    "transcriptionStarted": {
      "const": false
    },
    "diagnosticSafe": {
      "const": true
    },
    "tracks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "leakageFinalization": {
      "$ref": "#/$defs/leakageFinalization"
    }
  },
  "not": {
    "anyOf": [
      { "required": ["rawAudio"] },
      { "required": ["audioSnippet"] },
      { "required": ["transcriptText"] },
      { "required": ["meetingContent"] },
      { "required": ["participantSpeech"] },
      { "required": ["credentials"] },
      { "required": ["apiKey"] },
      { "required": ["tokens"] },
      { "required": ["signedUrls"] },
      { "required": ["password"] },
      { "required": ["absolutePath"] },
      { "required": ["liveSecretPath"] }
    ]
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": [
        "trackId",
        "role",
        "evidenceRole",
        "fileName",
        "format",
        "sampleRate",
        "channelCount",
        "bitsPerSample",
        "durationMs",
        "byteCount",
        "frameCount",
        "timelineStartMs",
        "timelineAligned",
        "failureReason"
      ],
      "properties": {
        "trackId": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "local_mic",
            "remote_speaker",
            "derived_local_mic",
            "mixed_meeting_audio"
          ]
        },
        "evidenceRole": {
          "enum": ["original", "derived"]
        },
        "fileName": { "type": "string", "minLength": 1 },
        "format": { "type": "string" },
        "sampleRate": { "type": "number" },
        "channelCount": { "type": "integer", "minimum": 1 },
        "bitsPerSample": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "byteCount": { "type": "integer", "minimum": 0 },
        "frameCount": { "type": "integer", "minimum": 0 },
        "timelineStartMs": { "type": "integer" },
        "timelineAligned": { "type": "boolean" },
        "failureReason": { "type": "string" },
        "sourceTrackIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "processorId": { "type": "string" },
        "processorVersion": { "type": "string" },
        "residualLeakageStatus": {
          "enum": [
            "clean",
            "leakage_detected",
            "unproven",
            "not_measured",
            "not_applicable"
          ]
        },
        "eligibleForTranscription": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "evidenceRole": { "const": "derived" } }
          },
          "then": {
            "required": [
              "sourceTrackIds",
              "processorId",
              "processorVersion",
              "residualLeakageStatus",
              "eligibleForTranscription"
            ]
          }
        }
      ]
    },
    "leakageFinalization": {
      "type": "object",
      "required": [
        "status",
        "evaluatedAt",
        "thresholdVersion",
        "measurementAttempted",
        "measurementApplicable",
        "alignmentStatus",
        "confidence",
        "failureReason",
        "transcriptionGate",
        "routeMetadata",
        "measurement"
      ],
      "properties": {
        "status": {
          "enum": [
            "clean",
            "leakage_detected",
            "unproven",
            "not_measured",
            "not_applicable"
          ]
        },
        "evaluatedAt": { "type": "string", "format": "date-time" },
        "thresholdVersion": { "type": "string", "minLength": 1 },
        "measurementAttempted": { "type": "boolean" },
        "measurementApplicable": { "type": "boolean" },
        "alignmentStatus": {
          "enum": [
            "aligned",
            "misaligned",
            "drift_detected",
            "insufficient_reference",
            "unknown"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "failureReason": { "type": "string" },
        "transcriptionGate": {
          "enum": [
            "eligible_original_dual",
            "eligible_derived_dual",
            "blocked_leakage_detected",
            "blocked_unproven",
            "blocked_not_measured",
            "blocked_timeline_misaligned",
            "not_applicable"
          ]
        },
        "routeMetadata": { "$ref": "#/$defs/routeMetadata" },
        "measurement": { "$ref": "#/$defs/measurement" }
      }
    },
    "routeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inputRouteClass": { "type": "string" },
        "outputRouteClass": { "type": "string" },
        "outputVolumeBucket": {
          "enum": ["muted", "low", "medium", "high", "unknown"]
        },
        "muteState": {
          "enum": ["muted", "unmuted", "unknown"]
        },
        "browserTarget": { "type": "string" },
        "routeChangeCount": { "type": "integer", "minimum": 0 },
        "coreaudiodState": { "type": "string" },
        "sleepWakeObserved": { "type": "boolean" },
        "selfRoutingRejected": { "type": "boolean" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowCount": { "type": "integer", "minimum": 0 },
        "farEndOnlyWindowMs": { "type": "integer", "minimum": 0 },
        "doubleTalkExcludedWindowMs": { "type": "integer", "minimum": 0 },
        "alignmentOffsetMs": { "type": "integer" },
        "alignmentDriftMs": { "type": "integer" },
        "leakageLevelDb": { "type": "number" },
        "correlationPeak": { "type": "number" },
        "correlationLagMs": { "type": "integer" },
        "directLoopbackSuspicion": { "type": "boolean" },
        "acousticLeakageSuspicion": { "type": "boolean" },
        "clippingObserved": { "type": "boolean" },
        "dropoutObserved": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
