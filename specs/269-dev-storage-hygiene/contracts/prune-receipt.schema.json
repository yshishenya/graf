{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graf.local/specs/269-dev-storage-hygiene/prune-receipt.schema.json",
  "title": "GRAF Dev prune receipt",
  "type": "object",
  "required": [
    "schema_version",
    "dry_run",
    "removed",
    "kept",
    "bytes_freed",
    "status",
    "partial_reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "dev-prune-receipt.v1"},
    "dry_run": {"type": "boolean"},
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "kind": {
            "type": "string",
            "enum": [
              "artifact_set",
              "archive",
              "app_bundle",
              "build_dir",
              "schema_snapshot",
              "app_backup",
              "image_tag"
            ]
          }
        }
      }
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manifest_id", "paths"],
        "additionalProperties": false,
        "properties": {
          "manifest_id": {"type": "string", "pattern": "^dev-[0-9a-f]{12}$"},
          "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "bytes_freed": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["ok", "partial"]},
    "partial_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1}
  }
}
