{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graf.local/contracts/meeting-target-registry.schema.json",
  "title": "GRAF Meeting Target Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryVersion",
    "generatedAt",
    "targets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "nonTargetRules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonTargetRule"
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "market",
        "platform",
        "targetFamily",
        "mode",
        "evidence",
        "requiredSignals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "market": {
          "type": "string",
          "enum": [
            "global",
            "russia",
            "enterprise",
            "unknown"
          ]
        },
        "platform": {
          "type": "string",
          "enum": [
            "macos",
            "windows",
            "browser",
            "cross_platform"
          ]
        },
        "targetFamily": {
          "type": "string",
          "enum": [
            "native_app",
            "browser_meeting",
            "provider",
            "manual_only"
          ]
        },
        "nativeBundleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]{1,200}$"
          },
          "uniqueItems": true
        },
        "windowsProcessNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\- ]{1,200}$"
          },
          "uniqueItems": true
        },
        "browserServicePatterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/browserServicePattern"
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "prompt_enabled",
            "diagnostic_only",
            "blocked_missing_bundle",
            "manual_or_browser_only",
            "disabled"
          ]
        },
        "evidence": {
          "type": "string",
          "enum": [
            "runtime_verified",
            "runtime_start_verified",
            "package_verified",
            "installed_verified",
            "confirmed",
            "seed",
            "verify_required",
            "future_windows"
          ]
        },
        "requiredSignals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "macos_audio_hal_assertion",
              "browser_metadata",
              "calendar_or_join_intent",
              "windows_future_adapter"
            ]
          },
          "uniqueItems": true
        },
        "comments": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "platform": {
                "const": "macos"
              },
              "targetFamily": {
                "const": "native_app"
              },
              "mode": {
                "const": "prompt_enabled"
              }
            },
            "required": [
              "platform",
              "targetFamily",
              "mode"
            ]
          },
          "then": {
            "required": [
              "nativeBundleIds"
            ]
          }
        }
      ]
    },
    "browserServicePattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceFamily",
        "hostCategory",
        "patternClass"
      ],
      "properties": {
        "serviceFamily": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_\\-]{2,80}$"
        },
        "hostCategory": {
          "type": "string",
          "enum": [
            "first_party",
            "enterprise_domain",
            "unknown"
          ]
        },
        "patternClass": {
          "type": "string",
          "enum": [
            "meeting_room",
            "join_intent",
            "landing",
            "settings",
            "unsupported"
          ]
        }
      }
    },
    "nonTargetRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "ruleKind",
        "ruleValue",
        "reasonCode"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "macos",
            "windows",
            "browser"
          ]
        },
        "ruleKind": {
          "type": "string",
          "enum": [
            "bundle_id",
            "bundle_prefix",
            "display_name_token",
            "category",
            "windows_process_name",
            "browser_service_family"
          ]
        },
        "ruleValue": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240
        },
        "reasonCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        }
      }
    }
  }
}
