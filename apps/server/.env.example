# 2brain Rec server local development settings.
# Copy to a private .env file and replace placeholders outside git.

TWOBRAIN_ENV=development
TWOBRAIN_API_HOST=0.0.0.0
TWOBRAIN_API_PORT=8080

TWOBRAIN_DATABASE_URL=postgresql+asyncpg://twobrain_rec:change-me@rec-postgres:5432/twobrain_rec

TWOBRAIN_MINIO_ENDPOINT=rec-minio:9000
TWOBRAIN_MINIO_ACCESS_KEY=change-me
TWOBRAIN_MINIO_SECRET_KEY=change-me
TWOBRAIN_MINIO_BUCKET=twobrain-rec-ingest
TWOBRAIN_MINIO_SECURE=false

TWOBRAIN_MAX_RECORDING_DURATION_SECONDS=14400
TWOBRAIN_MAX_TRACK_BYTES=2684354560
TWOBRAIN_MAX_PACKAGE_BYTES=5368709120
TWOBRAIN_MAX_UPLOAD_PART_BYTES=1073741824
TWOBRAIN_UPLOAD_SESSION_TTL_SECONDS=86400
TWOBRAIN_AUTH_SESSION_TTL_SECONDS=86400
TWOBRAIN_AUTH_CALLBACK_STATE_TTL_SECONDS=900
TWOBRAIN_AUTH_STORAGE_REGION_TAG=ru
TWOBRAIN_AUTH_RU_LOCAL_STORAGE_ATTESTED=false

TWOBRAIN_YANDEX_CLIENT_ID=replace-me
TWOBRAIN_YANDEX_CLIENT_SECRET_FILE=/run/secrets/yandex-client-secret
TWOBRAIN_YANDEX_REDIRECT_PATH=/api/v1/auth/callback/yandex
TWOBRAIN_VK_CLIENT_ID=replace-me
TWOBRAIN_VK_CLIENT_SECRET_FILE=/run/secrets/vk-client-secret
TWOBRAIN_VK_REDIRECT_PATH=/api/v1/auth/callback/vk
TWOBRAIN_TELEGRAM_BOT_NAME=replace-me
TWOBRAIN_TELEGRAM_CLIENT_ID=replace-me
TWOBRAIN_TELEGRAM_CLIENT_SECRET_FILE=/run/secrets/telegram-client-secret
TWOBRAIN_TELEGRAM_REDIRECT_PATH=/api/v1/auth/callback/telegram
TWOBRAIN_AUTH_BASE_URL=https://api.2brain.rec

TWOBRAIN_SUPPORT_INCIDENT_GITHUB_OWNER=yshishenya
TWOBRAIN_SUPPORT_INCIDENT_GITHUB_REPO=crisp
TWOBRAIN_SUPPORT_INCIDENT_GITHUB_TOKEN_FILE=/run/secrets/twobrain_support_incident_github_token
TWOBRAIN_SUPPORT_INCIDENT_GITHUB_TIMEOUT_SECONDS=4
TWOBRAIN_SUPPORT_INCIDENT_RATE_LIMIT_WINDOW_SECONDS=3600
TWOBRAIN_SUPPORT_INCIDENT_RATE_LIMIT_MAX_ATTEMPTS=10

TWOBRAIN_PROCESSING_ENABLED=false
TWOBRAIN_TEMPORAL_ADDRESS=rec-temporal:7233
TWOBRAIN_TEMPORAL_NAMESPACE=default
TWOBRAIN_TEMPORAL_TASK_QUEUE=twobrain-rec-processing
TWOBRAIN_PLAYBACK_NORMALIZATION_ENABLED=false
TWOBRAIN_PLAYBACK_NORMALIZATION_AUTOMATIC_DISPATCH_ENABLED=false
TWOBRAIN_PLAYBACK_NORMALIZATION_TASK_QUEUE=twobrain-rec-playback-normalization
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_DIRECTORY=/var/lib/twobrain-rec/playback-normalization
TWOBRAIN_PLAYBACK_NORMALIZATION_PROBE_TIMEOUT_SECONDS=60
TWOBRAIN_PLAYBACK_NORMALIZATION_ACTIVITY_TIMEOUT_SECONDS=21600
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKFLOW_TIMEOUT_SECONDS=43200
TWOBRAIN_PLAYBACK_NORMALIZATION_HEARTBEAT_SECONDS=30
TWOBRAIN_PLAYBACK_NORMALIZATION_RECONCILE_INTERVAL_SECONDS=60
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_BUDGET_BYTES=6442450944
TWOBRAIN_PLAYBACK_NORMALIZATION_OUTPUT_MAX_BYTES=134217728
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_RESERVE_BYTES=268435456
TWOBRAIN_PLAYBACK_NORMALIZATION_PROBE_STDOUT_MAX_BYTES=262144
TWOBRAIN_PLAYBACK_NORMALIZATION_PROCESS_STDERR_MAX_BYTES=1048576
TWOBRAIN_PLAYBACK_NORMALIZATION_MAX_STREAMS=16
TWOBRAIN_PLAYBACK_NORMALIZATION_MAX_AUDIO_STREAMS=8
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKER_CONCURRENCY=1
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKSPACE_PAGE_SIZE=50
TWOBRAIN_PLAYBACK_NORMALIZATION_INVENTORY_PAGE_SIZE=100
TWOBRAIN_PLAYBACK_NORMALIZATION_DISPATCH_BATCH_SIZE=25
TWOBRAIN_PLAYBACK_NORMALIZATION_FFMPEG_PATH=/usr/bin/ffmpeg
TWOBRAIN_PLAYBACK_NORMALIZATION_FFPROBE_PATH=/usr/bin/ffprobe
TWOBRAIN_PROCESSING_POLL_INTERVAL_SECONDS=5
TWOBRAIN_PROCESSING_MAX_POLL_ATTEMPTS=120
TWOBRAIN_MEDIASCRIBE_BASE_URL=https://mediascribe.example.invalid
TWOBRAIN_MEDIASCRIBE_API_KEY_FILE=/run/secrets/twobrain_mediascribe_api_key
TWOBRAIN_MEDIASCRIBE_REQUEST_TIMEOUT_SECONDS=30
TWOBRAIN_MEDIASCRIBE_DIARIZE=true
TWOBRAIN_MEDIASCRIBE_SUMMARIZE=false

TWOBRAIN_LOG_LEVEL=INFO
