<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup>
    <ProjectGuid>{4B4C31DA-2000-4E1A-9D4A-6BF7B4B25001}</ProjectGuid>
    <!-- wapproj does not automatically import Directory.Build.props. Keep the
         package graph on the same stable SDK as the native projects. -->
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion Condition="'$(TargetPlatformVersion)' == ''">10.0.26100.0</TargetPlatformVersion>
    <SDKIdentifier>UAP</SDKIdentifier>
    <!-- SDKVersion is the packaging pipeline generation (10.0); the concrete
         installed SDK is selected by TargetPlatformVersion above. -->
    <SDKVersion Condition="'$(SDKVersion)' == ''">10.0</SDKVersion>
    <TargetPlatformMinVersion>10.0.19045.0</TargetPlatformMinVersion>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <AppxPackage>true</AppxPackage>
    <!-- The payload is a native C++ WinUI 3 executable. Microsoft.DesktopBridge.props
         normally suppresses the .NET CoreRuntime imports, but this project does not
         import that props file, so Microsoft.Common.targets would pull
         Microsoft.Net.CoreRuntime.ImportAfter.targets in (TargetPlatformIdentifier is
         UAP and AppxPackage is true) and inject a Microsoft.NET.CoreRuntime.1.1
         package dependency. A native app must not carry it, and that dependency asks
         for a framework a clean Windows image does not have, which blocks install.
         Setting the same suppression here, before the imports at the end of the file
         are evaluated, is the minimal equivalent of that props file. -->
    <NetfxCoreRuntimeTargets>Empty</NetfxCoreRuntimeTargets>
    <NetfxCoreRuntimeSettingsTargets>Empty</NetfxCoreRuntimeSettingsTargets>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <SkipCopyBuildProduct>true</SkipCopyBuildProduct>
    <!-- The Desktop Bridge targets only stage the layout; the package itself is
         produced only when this is set. Keeping it in the project (instead of on
         the command line) matters because a command-line global property would
         also reach the referenced application project, which then tries to build
         its own MSIX and fails before this project can stage the payload. -->
    <GenerateAppxPackageOnBuild Condition="'$(GenerateAppxPackageOnBuild)' == ''">true</GenerateAppxPackageOnBuild>
    <EntryPointProjectUniqueName>..\RecApp\GrafWindowsApp.vcxproj</EntryPointProjectUniqueName>
    <EntryPointExe>GrafWindowsApp.exe</EntryPointExe>
    <AppxPackageDir>$(MSBuildThisFileDirectory)out\</AppxPackageDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>out\x64\Debug\</OutputPath>
    <IntermediateOutputPath>out\obj\GrafWindows.Package\x64\Debug\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>out\x64\Release\</OutputPath>
    <IntermediateOutputPath>out\obj\GrafWindows.Package\x64\Release\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <OutputPath>out\ARM64\Debug\</OutputPath>
    <IntermediateOutputPath>out\obj\GrafWindows.Package\ARM64\Debug\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <OutputPath>out\ARM64\Release\</OutputPath>
    <IntermediateOutputPath>out\obj\GrafWindows.Package\ARM64\Release\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The packaged payload takes its Windows App SDK runtime from package
         identity instead of bootstrapping it, so the entry project must be built
         with WindowsPackageType=MSIX. The standalone validation build keeps the
         default None. -->
    <ProjectReference Include="..\RecApp\GrafWindowsApp.vcxproj">
      <!-- Only this project may create an MSIX. The application project is built
           as a packaged payload (no self-bootstrap), never as its own package. -->
      <AdditionalProperties>GrafWindowsPackageType=MSIX;GenerateAppxPackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="Assets\Graf.ico" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
  </ItemGroup>
  <PropertyGroup>
    <GrafFFmpegRoot Condition="'$(GrafFFmpegRoot)' == '' and '$(GRAF_FFMPEG_ROOT)' != ''">$(GRAF_FFMPEG_ROOT)</GrafFFmpegRoot>
    <GrafFFmpegRoot Condition="'$(GrafFFmpegRoot)' == ''">$(MSBuildThisFileDirectory)..\out\ffmpeg-7.1.5-x64</GrafFFmpegRoot>
  </PropertyGroup>
  <!-- Exact upstream notices accompany every package; explicit items must not
       disappear silently when a source file is missing. -->
  <ItemGroup>
    <Content Include="..\Native\GrafFFmpeg\notices\COPYING.LGPLv2.1">
      <Link>ThirdPartyNotices\FFmpeg\COPYING.LGPLv2.1</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafFFmpeg\notices\LICENSE.md">
      <Link>ThirdPartyNotices\FFmpeg\LICENSE.md</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafFFmpeg\README.md">
      <Link>ThirdPartyNotices\FFmpeg\README.md</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafFFmpeg\manifest.json">
      <Link>ThirdPartyNotices\FFmpeg\manifest.json</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\scripts\build-graf-ffmpeg.ps1">
      <Link>ThirdPartyNotices\FFmpeg\build-graf-ffmpeg.ps1</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="$(GrafFFmpegRoot)\share\graf\ffmpeg-7.1.5.tar.xz">
      <Link>ThirdPartyNotices\FFmpeg\ffmpeg-7.1.5.tar.xz</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\COPYING">
      <Link>ThirdPartyNotices\GrafAEC3\COPYING</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\LICENSE">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\PATENTS">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\PATENTS</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\common_audio\third_party\ooura\LICENSE">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\common_audio\third_party\ooura\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\common_audio\third_party\spl_sqrt_floor\LICENSE">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\common_audio\third_party\spl_sqrt_floor\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\modules\third_party\fft\LICENSE">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\modules\third_party\fft\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\third_party\pffft\LICENSE">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\third_party\pffft\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\webrtc\third_party\rnnoise\COPYING">
      <Link>ThirdPartyNotices\GrafAEC3\webrtc\third_party\rnnoise\COPYING</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="..\Native\GrafAEC3\notices\Abseil\LICENSE">
      <Link>ThirdPartyNotices\Abseil\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\WebView2\LICENSE.txt">
      <Link>ThirdPartyNotices\WebView2\LICENSE.txt</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\WebView2\NOTICE.txt">
      <Link>ThirdPartyNotices\WebView2\NOTICE.txt</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\CppWinRT\LICENSE">
      <Link>ThirdPartyNotices\CppWinRT\LICENSE</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\WindowsAppSDK\license.txt">
      <Link>ThirdPartyNotices\WindowsAppSDK\license.txt</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\WindowsAppSDK\NOTICE.txt">
      <Link>ThirdPartyNotices\WindowsAppSDK\NOTICE.txt</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
    <Content Include="ThirdPartyNotices\SOURCES.json">
      <Link>ThirdPartyNotices\SOURCES.json</Link>
      <GrafRequiredNotice>true</GrafRequiredNotice>
    </Content>
  </ItemGroup>
  <Target Name="ValidateGrafThirdPartyNotices" BeforeTargets="PrepareForBuild">
    <Error Condition="'%(Content.GrafRequiredNotice)' == 'true' and !Exists('%(Content.FullPath)')"
           Text="Required third-party notice is missing: %(Content.Identity)" />
  </Target>
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets" Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\DesktopBridge\Microsoft.DesktopBridge.targets')" />
  <!-- Import last so Microsoft.Common.targets cannot overwrite Appx packaging hooks. -->
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.AppxPackage.Targets"
          Condition="Exists('$(MSBuildExtensionsPath)\Microsoft\VisualStudio\v$(VisualStudioVersion)\AppxPackage\Microsoft.AppxPackage.Targets')" />
</Project>
