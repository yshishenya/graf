{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graf:analytics:operator-evidence:v1",
  "title": "GRAF metadata-only operator evidence v1",
  "description": "Credential-free operator evidence for dashboard, rollback and alerting status. It contains no live provider identifiers, secrets or personal names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "receipts"],
  "properties": {
    "schema": {
      "const": "graf.analytics.operator-evidence.v1"
    },
    "mode": {
      "const": "metadata_only"
    },
    "receipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "dashboard"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "rollback"}}
          }
        },
        {
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {"kind": {"const": "alert"}}
          }
        }
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "receipt"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["dashboard", "rollback", "alert"]
        },
        "status": {
          "type": "string",
          "enum": ["applied", "partially_applied", "ready_not_executed", "metadata_only_not_executed"]
        },
        "receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/receipt"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "applied"}
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "allOf": [
                  {"$ref": "#/$defs/receipt"},
                  {"properties": {"status": {"const": "applied"}}}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"enum": ["ready_not_executed", "metadata_only_not_executed"]}
            }
          },
          "then": {
            "properties": {
              "receipt": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "dashboard"}
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "allOf": [
                  {"properties": {"kind": {"const": "dashboard"}, "scope": {"const": "dashboard_definitions"}}}
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "rollback"}
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "kind": {"const": "rollback"},
                  "scope": {"const": "provider_rollback"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {"const": "alert"}
            }
          },
          "then": {
            "properties": {
              "receipt": {
                "properties": {
                  "kind": {"const": "alert"},
                  "scope": {"const": "alert_rules_and_channel"}
                }
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "status",
        "recorded_at",
        "operator_role",
        "scope",
        "result",
        "checks"
      ],
      "properties": {
        "schema": {
          "const": "graf.analytics.operator-receipt.v1"
        },
        "kind": {
          "type": "string",
          "enum": ["dashboard", "rollback", "alert"]
        },
        "status": {
          "type": "string",
          "enum": ["applied", "partially_applied"]
        },
        "recorded_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "operator_role": {
          "type": "string",
          "enum": [
            "analytics_operator",
            "infra_operator",
            "product_owner",
            "release_owner",
            "qa_reviewer",
            "privacy_reviewer",
            "security_reviewer"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "dashboard_definitions",
            "provider_rollback",
            "alert_rules_and_channel"
          ]
        },
        "result": {
          "type": "string",
          "enum": ["pass", "partial"]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "definitions_applied": {"type": "boolean"},
            "freshness_verified": {"type": "boolean"},
            "empty_state_verified": {"type": "boolean"},
            "switches_verified": {"type": "boolean"},
            "product_workflows_preserved": {"type": "boolean"},
            "measurement_gap_only": {"type": "boolean"},
            "rules_have_owner_roles": {"type": "boolean"},
            "channel_probe_verified": {"type": "boolean"},
            "delivery_deadline_verified": {"type": "boolean"}
          }
        }
      }
    }
  }
}
