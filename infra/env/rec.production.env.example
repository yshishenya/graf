# GRAF production environment template.
# Copy outside git and replace placeholders during deployment.
# Live values must be provisioned through Docker secret files, never committed
# here and never injected as container environment values.
# This file is also loaded into app containers through docker-compose env_file.
# Service-specific secret-file paths must stay in docker-compose.yml service
# environment blocks or the root deployment .env used for compose interpolation.

TWOBRAIN_ENV=production
TWOBRAIN_PUBLIC_BASE_URL=https://rec.2brain.pro
TWOBRAIN_AUTH_BASE_URL=https://rec.2brain.pro
TWOBRAIN_DEPLOY_HOST=2brain.dev
TWOBRAIN_DEPLOY_PATH=/opt/projects/2brain-rec

# Required secret file classes.
# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_POSTGRES_PASSWORD_FILE=/run/secrets/twobrain_postgres_password
# Host-side paths for the three least-privilege runtime-role passwords. The deploy
# script creates strong values atomically when these files do not exist.
# TWOBRAIN_POSTGRES_APP_PASSWORD_FILE=./secrets/twobrain_postgres_app_password
# TWOBRAIN_POSTGRES_MAINTENANCE_PASSWORD_FILE=./secrets/twobrain_postgres_maintenance_password
# TWOBRAIN_POSTGRES_MEDIA_PASSWORD_FILE=./secrets/twobrain_postgres_media_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
# TWOBRAIN_MINIO_ROOT_USER_FILE=/run/secrets/twobrain_minio_root_user
# TWOBRAIN_MINIO_ROOT_PASSWORD_FILE=/run/secrets/twobrain_minio_root_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_MINIO_ACCESS_KEY_FILE=/run/secrets/twobrain_minio_api_access_key
TWOBRAIN_MINIO_SECRET_KEY_FILE=/run/secrets/twobrain_minio_api_secret_key

# GRAF credential encryption key for server-owned provider secrets. Generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# and mount it as a Docker secret before enabling credential-bearing integrations.
# It is a stable envelope-encryption key, not a user password and not a provider
# secret. If unset, GRAF fails closed before accepting app passwords or OAuth
# refresh material. Keep this service-specific path in docker-compose.yml for
# rec-api; do not put it in shared env_file unless every service mounts the
# same secret.
# GRAF_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/graf_credential_encryption_key
# Host-side path used by docker compose to mount the secret above.
# GRAF_CREDENTIAL_ENCRYPTION_KEY_SECRET_FILE=./secrets/graf_credential_encryption_key

TWOBRAIN_MINIO_ENDPOINT=rec-minio:9000
TWOBRAIN_MINIO_BUCKET=twobrain-rec-ingest
TWOBRAIN_MINIO_SECURE=false
TWOBRAIN_MAX_UPLOAD_PART_BYTES=1073741824

# RU-local auth/session/device/audit data boundary attestation.
# This is an operator attestation, not a secret. Production startup fails closed
# unless the deployment explicitly confirms auth storage is controlled in RU.
TWOBRAIN_AUTH_STORAGE_REGION_TAG=ru
TWOBRAIN_AUTH_RU_LOCAL_STORAGE_ATTESTED=true

# Server-owned CSRF/session bridge signing secret. Generate a random 32+ byte
# value and mount it as a Docker secret; never commit the value itself. The
# path is intentionally set only on rec-api in docker-compose.yml so workers
# and migrations cannot read this web-only secret.
# TWOBRAIN_WEB_CSRF_SECRET_FILE=/run/secrets/twobrain_web_csrf_secret

# Dedicated internal smoke identity/device. This is not a real user account,
# not a desktop uploader credential, and not the local development seed.
# Owner: 2brain deployment operator
# Rotation: after first production smoke and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_SMOKE_IDENTITY_CLASS=internal_smoke
# TWOBRAIN_SMOKE_CREDENTIAL_FILE=/run/secrets/twobrain_smoke_credential

# Browser email login delivery. These values are server-side only and are read
# by the API container; desktop clients never receive Postal settings.
# Internal default workspace for browser email login. Users never see or enter
# this UUID; the API uses it to resolve the self-hosted cabinet tenant.
TWOBRAIN_WEB_LOGIN_WORKSPACE_ID=

# Internal-only assisted auto-start. Keep disabled until policy,
# acknowledgement copy, expiry and release evidence are approved together.
# ALL_WORKSPACES requires the separate operator attestation below; an empty
# workspace ID is never interpreted as a wildcard without both flags.
TWOBRAIN_ASSISTED_AUTO_START_ENABLED=false
TWOBRAIN_ASSISTED_AUTO_START_ALL_WORKSPACES=false
TWOBRAIN_ASSISTED_AUTO_START_ALL_WORKSPACES_APPROVED=false
TWOBRAIN_ASSISTED_AUTO_START_WORKSPACE_ID=
TWOBRAIN_ASSISTED_AUTO_START_POLICY_VERSION=
TWOBRAIN_ASSISTED_AUTO_START_ACKNOWLEDGEMENT_VERSION=
TWOBRAIN_ASSISTED_AUTO_START_POLICY_ISSUED_AT=
TWOBRAIN_ASSISTED_AUTO_START_POLICY_EXPIRES_AT=
TWOBRAIN_EMAIL_LOGIN_DELIVERY_ENABLED=false
TWOBRAIN_EMAIL_LOGIN_FROM_ADDRESS=no-reply@rec.2brain.pro
TWOBRAIN_EMAIL_LOGIN_FROM_NAME='GRAF'

# Billing remains fail-closed until product, finance, legal, security and
# YooKassa real-shop gates are recorded. Never put secrets directly in env.
TWOBRAIN_BILLING_CHECKOUT_ENABLED=false
# Allows authenticated GET/list reconciliation of known provider objects only.
# It does not enable checkout, binding, refund, or any other provider POST.
TWOBRAIN_BILLING_PROVIDER_OBSERVATION_ENABLED=false
# Продовый магазин: rec.2brain.pro / YooKassa shopId 1430118. Checkout остаётся
# выключенным до canary и подписей; shopId не является секретом.
# The client appends /v3/{payments,refunds,receipts}; keep this at the API root.
TWOBRAIN_BILLING_YOOKASSA_BASE_URL=https://api.yookassa.ru
# YooKassa test and production shops can share this API host. The operator
# switches this explicit value together with SHOP_ID and the matching secret
# file for a sequential test window, then restores production before rollout.
TWOBRAIN_BILLING_YOOKASSA_ENVIRONMENT=production
TWOBRAIN_BILLING_YOOKASSA_SHOP_ID=1430118
# TWOBRAIN_BILLING_YOOKASSA_SECRET_FILE=./secrets/twobrain_yookassa_secret
# TWOBRAIN_BILLING_YOOKASSA_WEBHOOK_SECRET_FILE=./secrets/twobrain_yookassa_webhook_secret
# TWOBRAIN_BILLING_REFERRAL_SECRET_FILE=./secrets/twobrain_billing_referral_secret
TWOBRAIN_BILLING_PROVIDER_FLOOR_MINOR=1
# Fiscal receipt mapping is intentionally unset until finance/legal approve the
# YooKassa 54-FZ values. Checkout must remain disabled while these are blank.
TWOBRAIN_BILLING_RECEIPT_TAX_SYSTEM_CODE=0
TWOBRAIN_BILLING_RECEIPT_VAT_CODE=0
TWOBRAIN_BILLING_RECEIPT_PAYMENT_SUBJECT=service
TWOBRAIN_BILLING_RECEIPT_PAYMENT_MODE=full_payment
TWOBRAIN_BILLING_SUPPORT_EMAIL=yan@shishenya.ru
TWOBRAIN_BILLING_EMERGENCY_STOP=false
TWOBRAIN_POSTAL_API_URL=http://postal-web:5000
TWOBRAIN_POSTAL_DOCKER_NETWORK=postal_postal-network
TWOBRAIN_POSTAL_API_KEY_FILE=/run/secrets/twobrain_postal_api_key
TWOBRAIN_POSTAL_HOST_HEADER=postal.2brain.pro
TWOBRAIN_POSTAL_REQUEST_TIMEOUT_SECONDS=10
# Host-side path used by docker compose to mount the secret above.
# TWOBRAIN_POSTAL_API_SECRET_FILE=./secrets/twobrain_postal_api_key

# Exact-email B2C meeting invitations. Keep false until the operator has
# provisioned Postal, the encryption key, the public URL and the rollout
# evidence. Public links, team audience and referral attribution are separate
# capabilities and are not enabled by this switch.
TWOBRAIN_SHARE_EXTERNAL_INVITATIONS_ENABLED=false
TWOBRAIN_SHARE_IDENTITY_HASH_SECRET_FILE=/run/secrets/graf_share_identity_hash_secret
# TWOBRAIN_SHARE_IDENTITY_HASH_SECRET_SECRET_FILE=./secrets/graf_share_identity_hash_secret

# Public landing analytics. Disabled until legal readiness, Yandex Metrica
# goals, dashboard access, and campaign-readiness evidence are approved.
TWOBRAIN_PUBLIC_ANALYTICS_ENABLED=false
# Runtime-only numeric Yandex Metrica counter ID. Do not commit live IDs.
# TWOBRAIN_PUBLIC_ANALYTICS_YANDEX_METRICA_ID=
TWOBRAIN_PUBLIC_ANALYTICS_VALIDATION_MODE=disabled
TWOBRAIN_PUBLIC_ANALYTICS_REPLAY_ENABLED=false
TWOBRAIN_PUBLIC_ANALYTICS_CONSENT_COPY_VERSION=2026-08-13.1

# Product activation analytics 094. Disabled until legal/product/security/QA,
# provider smoke, dashboard readiness, rendered-page evidence, and separate
# rollout approval pass. Live provider IDs and tokens must stay outside git.
# These are commented because this env_file is shared by multiple app services.
# Product analytics runtime values are passed explicitly to rec-api in
# docker-compose.yml so worker/migrate services do not receive product analytics
# configuration accidentally.
# Owner role: product analytics operator with infrastructure operator backup;
# the Yandex offline owner is the growth analytics operator.
# Rotation: review on every provider credential, approval, or runtime-stack change.
# Failure behavior: disabled_optional_provider_secret fallback; provider delivery
# remains fail-closed until the required approvals and live secret files exist.
# TWOBRAIN_PRODUCT_ANALYTICS_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_VALIDATION_MODE=disabled
# TWOBRAIN_PRODUCT_ANALYTICS_PROVIDER_MODE=disabled
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_HOST=https://posthog.internal.example
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_PROJECT_KEY_FILE=/run/secrets/graf_posthog_project_key
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_AUTOCAPTURE_ENABLED=true
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_CREDENTIAL_SUPPRESSION_ENABLED=true
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_WEB_DIRECT_ENABLED=true
# TWOBRAIN_PRODUCT_ANALYTICS_POSTHOG_DESKTOP_DIRECT_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_ALL_PAGES_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_OFFLINE_ENABLED=false
# Runtime-only numeric Yandex counter ID. Do not commit live IDs.
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_COUNTER_ID=
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_OAUTH_TOKEN_FILE=/run/secrets/graf_yandex_offline_oauth_token
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_OAUTH_TOKEN_SECRET_FILE=./secrets/graf_yandex_offline_oauth_token
# TWOBRAIN_PRODUCT_ANALYTICS_YANDEX_INVENTORY_VERSION=096.2026-07-09.1
# TWOBRAIN_PRODUCT_ANALYTICS_ROLLBACK_MODE=none
# TWOBRAIN_PRODUCT_ANALYTICS_REPLAY_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_RETENTION_MIN_DAYS=90
# TWOBRAIN_PRODUCT_ANALYTICS_CONSENT_COPY_VERSION=2026-07-09.1
# TWOBRAIN_PRODUCT_ANALYTICS_DIRECT_DESKTOP_EGRESS_ENABLED=false
# TWOBRAIN_PRODUCT_ANALYTICS_DIRECT_DESKTOP_EGRESS_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_LEGAL_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_PRIVACY_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_SECURITY_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_QA_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_DISCLOSURE_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_DASHBOARD_READY=false
# TWOBRAIN_PRODUCT_ANALYTICS_PROVIDER_SMOKE_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_ROLLBACK_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_LIVE_PROVIDER_DELIVERY_APPROVED=false
# TWOBRAIN_PRODUCT_ANALYTICS_CAMPAIGN_READINESS_APPROVED=false

# Browser OAuth provider credentials. Client IDs are not secrets; client
# secrets must stay in Docker secret files and are mounted only into rec-api.
# Register these public callbacks in the provider console:
# - Yandex: https://rec.2brain.pro/api/v1/auth/callback/yandex
# - VK: https://rec.2brain.pro/api/v1/auth/callback/vk
TWOBRAIN_YANDEX_CLIENT_ID=
# TWOBRAIN_YANDEX_CLIENT_SECRET_FILE=./secrets/twobrain_yandex_client_secret
TWOBRAIN_VK_CLIENT_ID=
# TWOBRAIN_VK_CLIENT_SECRET_FILE=./secrets/twobrain_vk_client_secret

# Google Calendar is read-only and server-owned. The client secret is mounted
# only through the Docker secret file configured in docker-compose.yml.
TWOBRAIN_GOOGLE_CALENDAR_ENABLED=true
TWOBRAIN_GOOGLE_CALENDAR_CLIENT_ID=
TWOBRAIN_GOOGLE_CALENDAR_REDIRECT_URI=https://rec.2brain.pro/settings/integrations/calendar/google/callback

# Support incident GitHub intake token. The token value must stay in a Docker
# secret file mounted only into rec-api; it creates private GitHub issues for
# metadata-only user reports.
# Owner: 2brain deployment operator
# Rotation: GitHub token rotation or any credential exposure/change event
# Failure behavior: support report sending fails closed with copy fallback
# TWOBRAIN_SUPPORT_INCIDENT_GITHUB_TOKEN_FILE=./secrets/twobrain_support_incident_github_token

# Optional degraded-awareness dependencies. These checks do not block accepted
# 012 ingest smoke readiness and must not create content egress.
# Owner: 2brain deployment operator
# Rotation: dependency credential policy
# Failure behavior: record degraded awareness, do not block 012 smoke
TWOBRAIN_MEDIASCRIBE_BASE_URL=https://mediascribe.2brain.pro
TWOBRAIN_MEDIASCRIBE_HEALTH_URL=https://mediascribe.2brain.pro/health
TWOBRAIN_LANGFUSE_BASE_URL=https://cloud.langfuse.com
TWOBRAIN_LANGFUSE_HEALTH_URL=https://cloud.langfuse.com/api/public/health
# TWOBRAIN_LANGFUSE_CREDENTIAL_FILE=/run/secrets/twobrain_langfuse_awareness
TWOBRAIN_LANGFUSE_ENVIRONMENT=production
# Set by the deploy script to the exact deployed Git SHA.
TWOBRAIN_LANGFUSE_RELEASE=
TWOBRAIN_OUTCOME_GENERATION_ENABLED=false
TWOBRAIN_LITELLM_BASE_URL=
# TWOBRAIN_LITELLM_API_KEY_SECRET_FILE=./secrets/twobrain_litellm_api_key
# Operations-only GEPA worker settings. Keep the maintenance URL and password
# file in the operations Compose service; ordinary workers must not mount them.
TWOBRAIN_PROMPT_OPTIMIZATION_ENABLED=false
# TWOBRAIN_PROMPT_OPTIMIZATION_DATABASE_URL=postgresql+asyncpg://twobrain_rec_maintenance:__POSTGRES_PASSWORD__@rec-postgres:5432/twobrain_rec
# TWOBRAIN_PROMPT_OPTIMIZATION_POSTGRES_PASSWORD_FILE=/run/secrets/twobrain_postgres_password
TWOBRAIN_OUTCOME_TRANSCRIPT_CHUNK_BYTES=196608
TWOBRAIN_OUTCOME_TEMPORAL_PAYLOAD_BYTES=262144
TWOBRAIN_OUTCOME_TRANSCRIPT_MAX_BYTES=8388608
TWOBRAIN_SHARE_PUBLIC_LINKS_ENABLED=false
TWOBRAIN_SHARE_PUBLIC_LINKS_ABUSE_GATE_APPROVED=false

# 015 processing pipeline. Enable only after Temporal and MediaScribe secret
# files are provisioned. The API key value must stay in the Docker secret file.
TWOBRAIN_PROCESSING_ENABLED=false
TWOBRAIN_TEMPORAL_ADDRESS=rec-temporal:7233
TWOBRAIN_TEMPORAL_NAMESPACE=default
TWOBRAIN_TEMPORAL_TASK_QUEUE=twobrain-rec-processing
TWOBRAIN_PLAYBACK_NORMALIZATION_ENABLED=true
TWOBRAIN_PLAYBACK_NORMALIZATION_AUTOMATIC_DISPATCH_ENABLED=true
TWOBRAIN_PLAYBACK_NORMALIZATION_TASK_QUEUE=twobrain-rec-playback-normalization
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_DIRECTORY=/var/lib/twobrain-rec/playback-normalization
TWOBRAIN_PLAYBACK_NORMALIZATION_PROBE_TIMEOUT_SECONDS=60
TWOBRAIN_PLAYBACK_NORMALIZATION_ACTIVITY_TIMEOUT_SECONDS=21600
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKFLOW_TIMEOUT_SECONDS=43200
TWOBRAIN_PLAYBACK_NORMALIZATION_HEARTBEAT_SECONDS=30
TWOBRAIN_PLAYBACK_NORMALIZATION_RECONCILE_INTERVAL_SECONDS=60
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_BUDGET_BYTES=6442450944
TWOBRAIN_PLAYBACK_NORMALIZATION_OUTPUT_MAX_BYTES=134217728
TWOBRAIN_PLAYBACK_NORMALIZATION_WORK_RESERVE_BYTES=268435456
TWOBRAIN_PLAYBACK_NORMALIZATION_PROBE_STDOUT_MAX_BYTES=262144
TWOBRAIN_PLAYBACK_NORMALIZATION_PROCESS_STDERR_MAX_BYTES=1048576
TWOBRAIN_PLAYBACK_NORMALIZATION_MAX_STREAMS=16
TWOBRAIN_PLAYBACK_NORMALIZATION_MAX_AUDIO_STREAMS=8
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKER_CONCURRENCY=1
TWOBRAIN_PLAYBACK_NORMALIZATION_WORKSPACE_PAGE_SIZE=50
TWOBRAIN_PLAYBACK_NORMALIZATION_INVENTORY_PAGE_SIZE=100
TWOBRAIN_PLAYBACK_NORMALIZATION_DISPATCH_BATCH_SIZE=25
TWOBRAIN_PLAYBACK_NORMALIZATION_FFMPEG_PATH=/usr/bin/ffmpeg
TWOBRAIN_PLAYBACK_NORMALIZATION_FFPROBE_PATH=/usr/bin/ffprobe
TWOBRAIN_PROCESSING_POLL_INTERVAL_SECONDS=5
TWOBRAIN_PROCESSING_MAX_POLL_ATTEMPTS=120
# TWOBRAIN_MEDIASCRIBE_API_KEY_FILE=/run/secrets/twobrain_mediascribe_api_key
TWOBRAIN_MEDIASCRIBE_REQUEST_TIMEOUT_SECONDS=30
TWOBRAIN_MEDIASCRIBE_DIARIZE=true
TWOBRAIN_MEDIASCRIBE_SUMMARIZE=false
