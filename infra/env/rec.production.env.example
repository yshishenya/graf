# 2brain Rec production environment template.
# Copy outside git and replace placeholders during deployment.
# Live values must be provisioned through Docker secret files, never committed
# here and never injected as container environment values.

TWOBRAIN_ENV=production
TWOBRAIN_PUBLIC_BASE_URL=https://rec.2brain.pro
TWOBRAIN_DEPLOY_HOST=2brain.dev
TWOBRAIN_DEPLOY_PATH=/opt/projects/2brain-rec

# Required secret file classes.
# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_POSTGRES_PASSWORD_FILE=/run/secrets/twobrain_postgres_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_MINIO_ROOT_USER_FILE=/run/secrets/twobrain_minio_root_user
TWOBRAIN_MINIO_ROOT_PASSWORD_FILE=/run/secrets/twobrain_minio_root_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_MINIO_ACCESS_KEY_FILE=/run/secrets/twobrain_minio_api_access_key
TWOBRAIN_MINIO_SECRET_KEY_FILE=/run/secrets/twobrain_minio_api_secret_key

TWOBRAIN_MINIO_ENDPOINT=rec-minio:9000
TWOBRAIN_MINIO_BUCKET=twobrain-rec-ingest
TWOBRAIN_MINIO_SECURE=false

# RU-local auth/session/device/audit data boundary attestation.
# This is an operator attestation, not a secret. Production startup fails closed
# unless the deployment explicitly confirms auth storage is controlled in RU.
TWOBRAIN_AUTH_STORAGE_REGION_TAG=ru
TWOBRAIN_AUTH_RU_LOCAL_STORAGE_ATTESTED=true

# Dedicated internal smoke identity/device. This is not a real user account,
# not a desktop uploader credential, and not the local development seed.
# Owner: 2brain deployment operator
# Rotation: after first production smoke and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_SMOKE_IDENTITY_CLASS=internal_smoke
TWOBRAIN_SMOKE_CREDENTIAL_FILE=/run/secrets/twobrain_smoke_credential

# Optional degraded-awareness dependencies. These checks do not block accepted
# 012 ingest smoke readiness and must not create content egress.
# Owner: 2brain deployment operator
# Rotation: dependency credential policy
# Failure behavior: record degraded awareness, do not block 012 smoke
TWOBRAIN_MEDIASCRIBE_BASE_URL=https://mediascribe.2brain.pro
TWOBRAIN_MEDIASCRIBE_HEALTH_URL=https://mediascribe.2brain.pro/health
TWOBRAIN_MEDIASCRIBE_CREDENTIAL_FILE=/run/secrets/twobrain_mediascribe_awareness
TWOBRAIN_LANGFUSE_BASE_URL=https://langfuse.2brain.pro
TWOBRAIN_LANGFUSE_HEALTH_URL=https://langfuse.2brain.pro/api/public/health
TWOBRAIN_LANGFUSE_CREDENTIAL_FILE=/run/secrets/twobrain_langfuse_awareness
