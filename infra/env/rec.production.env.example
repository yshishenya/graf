# GRAF production environment template.
# Copy outside git and replace placeholders during deployment.
# Live values must be provisioned through Docker secret files, never committed
# here and never injected as container environment values.
# This file is also loaded into app containers through docker-compose env_file.
# Service-specific secret-file paths must stay in docker-compose.yml service
# environment blocks or the root deployment .env used for compose interpolation.

TWOBRAIN_ENV=production
TWOBRAIN_PUBLIC_BASE_URL=https://rec.2brain.pro
TWOBRAIN_AUTH_BASE_URL=https://rec.2brain.pro
TWOBRAIN_DEPLOY_HOST=2brain.dev
TWOBRAIN_DEPLOY_PATH=/opt/projects/2brain-rec

# Required secret file classes.
# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_POSTGRES_PASSWORD_FILE=/run/secrets/twobrain_postgres_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
# TWOBRAIN_MINIO_ROOT_USER_FILE=/run/secrets/twobrain_minio_root_user
# TWOBRAIN_MINIO_ROOT_PASSWORD_FILE=/run/secrets/twobrain_minio_root_password

# Owner: 2brain deployment operator
# Rotation: initial deployment and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_MINIO_ACCESS_KEY_FILE=/run/secrets/twobrain_minio_api_access_key
TWOBRAIN_MINIO_SECRET_KEY_FILE=/run/secrets/twobrain_minio_api_secret_key

# Calendar credential sealing key. Generate with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# and mount it as a Docker secret before enabling credential-bearing calendar
# sources in production. If unset, calendar source connect fails closed before
# accepting app passwords or OAuth refresh material.
# TWOBRAIN_CALENDAR_CREDENTIAL_KEY_FILE=/run/secrets/twobrain_calendar_credential_key

TWOBRAIN_MINIO_ENDPOINT=rec-minio:9000
TWOBRAIN_MINIO_BUCKET=twobrain-rec-ingest
TWOBRAIN_MINIO_SECURE=false
TWOBRAIN_MAX_UPLOAD_PART_BYTES=1073741824

# RU-local auth/session/device/audit data boundary attestation.
# This is an operator attestation, not a secret. Production startup fails closed
# unless the deployment explicitly confirms auth storage is controlled in RU.
TWOBRAIN_AUTH_STORAGE_REGION_TAG=ru
TWOBRAIN_AUTH_RU_LOCAL_STORAGE_ATTESTED=true

# Server-owned CSRF/session bridge signing secret. Generate a random 32+ byte
# value and mount it as a Docker secret; never commit the value itself.
TWOBRAIN_WEB_CSRF_SECRET_FILE=/run/secrets/twobrain_web_csrf_secret

# Dedicated internal smoke identity/device. This is not a real user account,
# not a desktop uploader credential, and not the local development seed.
# Owner: 2brain deployment operator
# Rotation: after first production smoke and any credential exposure/change event
# Failure behavior: fail closed before smoke
TWOBRAIN_SMOKE_IDENTITY_CLASS=internal_smoke
# TWOBRAIN_SMOKE_CREDENTIAL_FILE=/run/secrets/twobrain_smoke_credential

# Browser email login delivery. These values are server-side only and are read
# by the API container; desktop clients never receive Postal settings.
# Internal default workspace for browser email login. Users never see or enter
# this UUID; the API uses it to resolve the self-hosted cabinet tenant.
TWOBRAIN_WEB_LOGIN_WORKSPACE_ID=
TWOBRAIN_EMAIL_LOGIN_DELIVERY_ENABLED=false
TWOBRAIN_EMAIL_LOGIN_FROM_ADDRESS=no-reply@rec.2brain.pro
TWOBRAIN_EMAIL_LOGIN_FROM_NAME='GRAF'
TWOBRAIN_POSTAL_API_URL=http://postal-web:5000
TWOBRAIN_POSTAL_DOCKER_NETWORK=postal_postal-network
TWOBRAIN_POSTAL_API_KEY_FILE=/run/secrets/twobrain_postal_api_key
TWOBRAIN_POSTAL_HOST_HEADER=postal.2brain.pro
TWOBRAIN_POSTAL_REQUEST_TIMEOUT_SECONDS=10
# Host-side path used by docker compose to mount the secret above.
# TWOBRAIN_POSTAL_API_SECRET_FILE=./secrets/twobrain_postal_api_key

# Browser OAuth provider credentials. Client IDs are not secrets; client
# secrets must stay in Docker secret files and are mounted only into rec-api.
# Register these public callbacks in the provider console:
# - Yandex: https://rec.2brain.pro/api/v1/auth/callback/yandex
# - VK: https://rec.2brain.pro/api/v1/auth/callback/vk
TWOBRAIN_YANDEX_CLIENT_ID=
# TWOBRAIN_YANDEX_CLIENT_SECRET_FILE=./secrets/twobrain_yandex_client_secret
TWOBRAIN_VK_CLIENT_ID=
# TWOBRAIN_VK_CLIENT_SECRET_FILE=./secrets/twobrain_vk_client_secret

# Optional degraded-awareness dependencies. These checks do not block accepted
# 012 ingest smoke readiness and must not create content egress.
# Owner: 2brain deployment operator
# Rotation: dependency credential policy
# Failure behavior: record degraded awareness, do not block 012 smoke
TWOBRAIN_MEDIASCRIBE_BASE_URL=https://mediascribe.2brain.pro
TWOBRAIN_MEDIASCRIBE_HEALTH_URL=https://mediascribe.2brain.pro/health
TWOBRAIN_LANGFUSE_BASE_URL=https://langfuse.2brain.pro
TWOBRAIN_LANGFUSE_HEALTH_URL=https://langfuse.2brain.pro/api/public/health
# TWOBRAIN_LANGFUSE_CREDENTIAL_FILE=/run/secrets/twobrain_langfuse_awareness

# 015 processing pipeline. Enable only after Temporal and MediaScribe secret
# files are provisioned. The API key value must stay in the Docker secret file.
TWOBRAIN_PROCESSING_ENABLED=false
TWOBRAIN_TEMPORAL_ADDRESS=rec-temporal:7233
TWOBRAIN_TEMPORAL_NAMESPACE=default
TWOBRAIN_TEMPORAL_TASK_QUEUE=twobrain-rec-processing
TWOBRAIN_PROCESSING_POLL_INTERVAL_SECONDS=5
TWOBRAIN_PROCESSING_MAX_POLL_ATTEMPTS=120
# TWOBRAIN_MEDIASCRIBE_API_KEY_FILE=/run/secrets/twobrain_mediascribe_api_key
TWOBRAIN_MEDIASCRIBE_REQUEST_TIMEOUT_SECONDS=30
TWOBRAIN_MEDIASCRIBE_DIARIZE=true
TWOBRAIN_MEDIASCRIBE_SUMMARIZE=false
