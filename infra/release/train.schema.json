{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:graf:release-train:v1",
  "title": "GRAF metadata-only release train manifest v1",
  "description": "An immutable binding between merged work, receipts and one release decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "train_id",
    "source_sha",
    "base_sha",
    "synthetic_merge_sha",
    "included_prs",
    "feature_ids",
    "merge_group_ids",
    "pr_receipts",
    "merge_group_receipts",
    "changelog_digest",
    "authoritative_full_ci_receipt",
    "decision",
    "rollback_target"
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "receipt_digest", "target_sha"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "target_sha": {"$ref": "#/$defs/sha"},
        "status": {"type": "string", "enum": ["passed", "failed", "cancelled", "superseded", "stale", "ambiguous"]},
        "pull_request_numbers": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "merge_group_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,256}$"}
      }
    },
    "full_receipt_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "receipt_digest", "target_sha", "status"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,160}$"},
        "receipt_digest": {"$ref": "#/$defs/digest"},
        "target_sha": {"$ref": "#/$defs/sha"},
        "status": {"type": "string", "const": "passed"},
        "lane": {"type": "string", "const": "full"}
      }
    },
    "receipt_reference": {
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,512}$"},
        {"$ref": "#/$defs/receipt_ref"}
      ]
    }
  },
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "train_id": {"type": "string", "pattern": "^train-[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "operator": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_sha": {"$ref": "#/$defs/sha"},
    "base_sha": {"$ref": "#/$defs/sha"},
    "synthetic_merge_sha": {"$ref": "#/$defs/sha"},
    "included_prs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9]{3,}$"}
    },
    "merge_group_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,256}$"}
    },
    "pr_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt_reference"}},
    "merge_group_receipts": {"type": "array", "items": {"$ref": "#/$defs/receipt_reference"}},
    "changelog_digest": {"$ref": "#/$defs/digest"},
    "authoritative_full_ci_receipt": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/full_receipt_ref"}]
    },
    "decision": {"type": "string", "enum": ["pending", "go", "no-go"]},
    "rollback_target": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
