# Copy to /etc/graf-posthog-backup.env outside git, mode 0600, root-owned.
# Before starting: persist the explicitly selected API TWOBRAIN_RUNTIME_SECRET_GID
# using the mandatory shared-reader-group block in the PostHog runbook.
# Local-only policy accepted on 2026-10-22. Host/disk loss may lose all history.
GRAF_POSTHOG_BACKUP_DIR=/var/backups/graf-posthog
GRAF_POSTHOG_BACKUP_STATE_DIR=/var/lib/graf-posthog-backup
GRAF_POSTHOG_RESTORE_EVIDENCE_DIR=/var/lib/graf-posthog-restore-evidence
# Only verified complete sets count. Partial sets never evict usable copies.
GRAF_POSTHOG_BACKUP_KEEP=7
GRAF_POSTHOG_BACKUP_MIN_COPIES=2
GRAF_POSTHOG_BACKUP_INVENTORY=/usr/local/libexec/graf-posthog-backup-volumes.txt
GRAF_POSTHOG_BACKUP_IMAGE=alpine:3.20
# Age is measured from successful completion: 0 <= age < 26h.
GRAF_POSTHOG_BACKUP_MAX_AGE_HOURS=26
GRAF_POSTHOG_RESTORE_MAX_AGE_DAYS=30
