# Copy to /etc/graf-posthog-backup.env outside git, mode 0600, root-owned.
#
# Backup, restore verification and their alerting read this file. It contains no
# credentials by itself, but the offsite command may reference an
# operator-controlled credential store; never place a credential value here.

# Local copy location and metadata-only state.
GRAF_POSTHOG_BACKUP_DIR=/var/backups/graf-posthog
GRAF_POSTHOG_BACKUP_STATE_DIR=/var/lib/graf-posthog-backup
GRAF_POSTHOG_RESTORE_EVIDENCE_DIR=/var/lib/graf-posthog-restore-evidence
# At least two copies must be kept (FR-052); the default keeps seven daily
# copies and never deletes below the minimum.
GRAF_POSTHOG_BACKUP_KEEP=7
GRAF_POSTHOG_BACKUP_MIN_COPIES=2
GRAF_POSTHOG_BACKUP_MIN_OFFSITE_COPIES=1

# Volume class inventory installed next to the scripts.
GRAF_POSTHOG_BACKUP_INVENTORY=/usr/local/libexec/graf-posthog-backup-volumes.txt
# Pinned helper image used to archive and unpack volumes.
GRAF_POSTHOG_BACKUP_IMAGE=alpine:3.20

# Offsite copy is required (FR-033, FR-052). The command runs after the archives
# are written and must exit non-zero when the upload did not succeed. It
# receives the backup directory in %ARCHIVE% (and in
# GRAF_POSTHOG_BACKUP_ARCHIVE_DIR) and the label in %LABEL%.
# Example shapes (choose one reviewed mechanism, never commit its credential):
#   GRAF_POSTHOG_OFFSITE_COMMAND='rsync -a --delete %ARCHIVE%/ backup-host:/srv/graf-posthog/%LABEL%/'
#   GRAF_POSTHOG_OFFSITE_COMMAND='aws s3 sync %ARCHIVE% s3://<bucket>/graf-posthog/%LABEL%/'
GRAF_POSTHOG_OFFSITE_TARGET_LABEL=operator_offsite_target
GRAF_POSTHOG_OFFSITE_COMMAND=

# Readiness thresholds shared with the readiness report (FR-034, FR-035).
GRAF_POSTHOG_BACKUP_MAX_AGE_HOURS=26
GRAF_POSTHOG_RESTORE_MAX_AGE_DAYS=30
