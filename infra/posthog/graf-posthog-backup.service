[Unit]
Description=GRAF PostHog analytics backup with offsite copy
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/graf-posthog-backup.env
ExecStart=/usr/local/libexec/graf-posthog-backup.sh --execute
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=-/var/backups/graf-posthog
ReadWritePaths=-/var/lib/graf-posthog-backup
ReadWritePaths=-/var/lib/graf-posthog-restore-evidence
ReadWritePaths=-/run/docker.sock
ReadWritePaths=-/var/run/docker.sock
TimeoutStartSec=6h
