# Redacted PostHog runtime env example for feature 096.
# Copy outside git and fill values only in the production secret/config store.

DOMAIN=analytics.2brain.pro
SITE_URL=https://analytics.2brain.pro
ALLOWED_HOSTS=analytics.2brain.pro
REGISTRY_URL=posthog/posthog
POSTHOG_APP_TAG=REPLACE_WITH_PINNED_RELEASE_TAG
POSTHOG_IMAGE=posthog/posthog:REPLACE_WITH_PINNED_RELEASE_TAG

# Secret values are supplied by Docker secret files, not committed env values.
POSTHOG_SECRET_KEY_FILE=/run/secrets/posthog_secret_key
POSTHOG_DB_PASSWORD_FILE=/run/secrets/posthog_db_password

# Retention and operations metadata.
POSTHOG_RETENTION_MIN_DAYS=90
POSTHOG_RESOURCE_LIMIT_CPU_WEB=2
POSTHOG_RESOURCE_LIMIT_MEMORY_WEB=4g
POSTHOG_RESOURCE_LIMIT_CPU_WORKER=2
POSTHOG_RESOURCE_LIMIT_MEMORY_WORKER=4g
POSTHOG_RESOURCE_LIMIT_CPU_DB=2
POSTHOG_RESOURCE_LIMIT_MEMORY_DB=2g
POSTHOG_RESOURCE_LIMIT_CPU_REDIS=1
POSTHOG_RESOURCE_LIMIT_MEMORY_REDIS=1g

# Replay remains disabled unless a later page-class proof approves it.
POSTHOG_SESSION_REPLAY_ENABLED=false

# Evidence policy.
POSTHOG_EVIDENCE_MODE=metadata_only
POSTHOG_LIVE_SECRET_VALUES_IN_GIT=false
