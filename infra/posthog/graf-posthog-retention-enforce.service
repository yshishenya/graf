[Unit]
Description=GRAF product analytics retention enforcement
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/graf-posthog-retention.env
ExecStart=/usr/local/libexec/graf-posthog-retention-enforce.sh --execute
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=-/var/lib/graf-posthog-retention
ReadWritePaths=-/run/docker.sock
ReadWritePaths=-/var/run/docker.sock
TimeoutStartSec=2h
