# Copy to /etc/graf-posthog-runtime-guard.env outside git.
GRAF_POSTHOG_PROJECT=graf-posthog
GRAF_APP_DIR=/opt/projects/2brain-rec
GRAF_POSTHOG_ANALYTICS_PATH=/opt/projects/graf-posthog
GRAF_POSTHOG_GUARD_STATE_DIR=/var/lib/graf-posthog-runtime-guard
# Safe defaults: observe and report only. Enable rollback only through a
# separately reviewed production override after the dry-run receipt passes.
GRAF_POSTHOG_GUARD_AUTO_ROLLBACK=0
GRAF_POSTHOG_GUARD_DRY_RUN=1
GRAF_POSTHOG_GUARD_STOP_STACK=0

# Threshold scopes (FR-031, FR-032, SC-012).
#
# The analytics scope fires first and can disable measurement only. The host
# scope alerts only and never disables measurement, so a traffic spike on the
# public site cannot stop measurement by itself. Every value below defaults to
# the previous hard-coded threshold; removing a line keeps production behaviour.
#
# Analytics scope.
# One failed analytics probe is already a measurement outage; the host scope
# still waits for two probe failures.
GRAF_POSTHOG_GUARD_ANALYTICS_HEALTH_FAILURES=1
# Analytics storage fill is reviewed at 20% free, long before the host disk
# threshold at 10% free.
GRAF_POSTHOG_GUARD_ANALYTICS_DISK_FREE_PERCENT=20
# Delivery lag: age of the newest event accepted by the analytics stack.
GRAF_POSTHOG_GUARD_ANALYTICS_LAG_SECONDS=900
# Ingest queue backlog and its growth per minute, read from the analytics
# ClickHouse `system.kafka_consumers` view. Set GRAF_POSTHOG_GUARD_QUEUE_QUERY
# to any reviewed scalar query when the runtime exposes the backlog differently.
GRAF_POSTHOG_GUARD_ANALYTICS_QUEUE_DEPTH=100000
GRAF_POSTHOG_GUARD_ANALYTICS_QUEUE_GROWTH_PER_MIN=5000
# 0 keeps an unreadable analytics probe as an alert only. Turn it to 1 after the
# first production receipt proves the probes are readable, so a broken probe
# disables measurement instead of passing silently.
GRAF_POSTHOG_GUARD_ANALYTICS_STRICT_METRICS=0
GRAF_POSTHOG_GUARD_EVENTS_TABLE=events

# Host scope. These thresholds alert only; they never disable measurement.
GRAF_POSTHOG_GUARD_HOST_LOAD=11
GRAF_POSTHOG_GUARD_HOST_MEMORY_MIB=16384
GRAF_POSTHOG_GUARD_HOST_DISK_FREE_PERCENT=10
GRAF_POSTHOG_GUARD_HOST_HEALTH_FAILURES=2
