# Copy to /etc/graf-posthog-retention.env outside git, mode 0600, root-owned.
#
# Retention enforcement for measurement events (ClickHouse) and for the
# anonymous aggregate, visit attribution and client acquisition attribute
# (PostgreSQL product database). The scheduled task deletes only these three
# local product-analytics tables; provider-held rows and billing provider-event
# metadata are outside its deletion scope.

# Metadata-only state read by readiness and by the external alert.
GRAF_PRODUCT_ANALYTICS_RETENTION_STATE_DIR=/var/lib/graf-posthog-retention

# Approved terms (FR-036, FR-050). A term that is absent or zero is a
# configuration error and blocks the analytics readiness claim; retention is
# never "forever by default".
POSTHOG_EVENT_RETENTION_DAYS=365

# Product database access. The task runs on the product host and deletes by age
# with an explicit statement per category, logging the removed row count only.
GRAF_APP_COMPOSE_FILE=/opt/projects/2brain-rec/infra/docker-compose.yml
GRAF_PRODUCT_ANALYTICS_DATABASE_SERVICE=rec-postgres
GRAF_PRODUCT_ANALYTICS_DATABASE_NAME=twobrain_rec
GRAF_PRODUCT_ANALYTICS_DATABASE_USER=twobrain_rec

# PostHog project name and optional explicit ClickHouse container.
GRAF_POSTHOG_PROJECT=graf-posthog
# GRAF_PRODUCT_ANALYTICS_CLICKHOUSE_CONTAINER=
