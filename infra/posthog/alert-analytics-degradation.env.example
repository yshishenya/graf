# Copy to /etc/graf-analytics-alert.env outside git, mode 0600, root-owned.
#
# No value in this file may be committed. The bot token and the chat identifier
# are credentials: keep them in this out-of-git file or in the files referenced
# below. The script never prints them and never copies them into state files,
# alerts or evidence (FR-054).

# External channel (FR-030). Both values are required before an alert can be
# delivered; without them the script fails closed and records
# `alert_channel_unavailable` locally (FR-056).
GRAF_ANALYTICS_ALERT_BOT_TOKEN=
GRAF_ANALYTICS_ALERT_CHAT_ID=
# Optional alternative to inline values: root-owned files that hold one value.
# GRAF_ANALYTICS_ALERT_BOT_TOKEN_FILE=/etc/graf-analytics-alert-bot-token
# GRAF_ANALYTICS_ALERT_CHAT_ID_FILE=/etc/graf-analytics-alert-chat-id

# Independent transport used when the primary channel cannot deliver, and for
# the channel-outage notice (FR-056). A generic JSON webhook is enough.
# GRAF_ANALYTICS_ALERT_FALLBACK_URL=

# Delivery deadline is at most 15 minutes (SC-009). The timer runs every
# 5 minutes; an unchanged condition is re-sent after this window.
GRAF_ANALYTICS_ALERT_REPEAT_MINUTES=60
# A guard state older than this is itself a degradation: the guard stopped.
GRAF_ANALYTICS_ALERT_STATE_MAX_AGE_MINUTES=15
GRAF_ANALYTICS_ALERT_TIMEOUT_SECONDS=10

# Named owners (FR-055). The rule-to-role mapping is committed in
# infra/posthog/alert-rules.txt; the person behind the role is named here and
# never in the repository.
# GRAF_ANALYTICS_ALERT_OWNER_INFRA_OPERATOR=
# GRAF_ANALYTICS_ALERT_OWNER_ANALYTICS_OPERATOR=
# GRAF_ANALYTICS_ALERT_OWNER_PRODUCT_OWNER=

# State locations. Defaults match the systemd units.
# GRAF_ANALYTICS_ALERT_STATE_DIR=/var/lib/graf-analytics-alert
# GRAF_ANALYTICS_ALERT_RULES_FILE=/etc/graf-analytics-alert-rules.txt
# GRAF_ANALYTICS_GUARD_STATE_FILE=/var/lib/graf-posthog-runtime-guard/alert-state
# GRAF_ANALYTICS_BACKUP_STATE_FILE=/var/lib/graf-posthog-backup/backup-state
# GRAF_ANALYTICS_RESTORE_STATE_FILE=/var/lib/graf-posthog-backup/restore-state
# GRAF_ANALYTICS_RETENTION_STATE_FILE=/var/lib/graf-posthog-retention/retention-state

# Readiness thresholds shared with the readiness report (FR-034, FR-052).
# GRAF_POSTHOG_BACKUP_MAX_AGE_HOURS=26
# GRAF_POSTHOG_RESTORE_MAX_AGE_DAYS=30
# GRAF_POSTHOG_BACKUP_MIN_COPIES=2
# GRAF_POSTHOG_BACKUP_MIN_OFFSITE_COPIES=1
