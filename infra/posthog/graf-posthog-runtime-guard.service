[Unit]
Description=GRAF PostHog resource and health guard
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/graf-posthog-runtime-guard.env
ExecStart=/usr/bin/env GRAF_POSTHOG_STORAGE_STATE_DIR=/var/lib/graf-posthog-storage GRAF_POSTHOG_STORAGE_STATE_FILE=/var/lib/graf-posthog-storage/storage-growth-state /usr/local/libexec/graf-posthog-runtime-guard.sh
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=/var/lib/graf-posthog-runtime-guard /var/lib/graf-posthog-storage /opt/projects/2brain-rec
