{
  "schema": "2brain.rec.release_hardening_evidence.v1",
  "allowedResult": ["passed", "blocked", "not_accepted"],
  "requiredFields": [
    "run_id",
    "created_at",
    "macos_version",
    "app_build",
    "driver_build",
    "result",
    "notes"
  ],
  "evidenceFamilies": [
    "installed_runtime",
    "no_hang",
    "short_smoke",
    "route_recovery",
    "installer_lifecycle",
    "diagnostics",
    "ux_readiness",
    "deferred_recording_acceptance"
  ],
  "forbiddenFields": [
    "rawAudio",
    "audioSnippet",
    "transcriptText",
    "meetingContent",
    "credentials",
    "tokens",
    "signedUrls",
    "password"
  ],
  "rules": {
    "metadataOnly": true,
    "skippedTargetsAreNotAccepted": true,
    "shortSmokeIsNotLongDurationAcceptance": true,
    "recordingTranscriptionUploadMustRemainInactive": true
  }
}
