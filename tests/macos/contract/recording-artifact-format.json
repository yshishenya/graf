{
  "schemaVersion": "recording-artifact-format.v2",
  "package": {
    "manifestSchemaVersion": "local-recording-manifest.v5",
    "manifestFileName": "manifest.json",
    "requiredFiles": ["meeting-transcription.wav", "meeting-review.m4a"],
    "exactFinalMembers": [
      "manifest.json",
      "meeting-transcription.wav",
      "meeting-review.m4a"
    ],
    "mediaScribeSourceMode": "single_wav_v1",
    "serverSourceKind": "initial_mixed_recording",
    "transportRoles": ["manifest", "media", "playback"],
    "externalEgressStarted": false,
    "transcriptionStarted": false
  },
  "tracks": [
    {
      "role": "mixed_meeting_audio",
      "transportRole": "media",
      "sourceKind": "canonical_mix",
      "mediaScribeField": "media_file",
      "fileName": "meeting-transcription.wav",
      "format": "wav-pcm-s16le",
      "sampleRate": 16000,
      "channelCount": 1,
      "bitsPerSample": 16,
      "timelineStartMs": 0,
      "timelineAligned": true,
      "asrInput": true
    },
    {
      "role": "review_playback",
      "transportRole": "playback",
      "sourceKind": "canonical_mix",
      "mediaScribeField": "playback_file",
      "fileName": "meeting-review.m4a",
      "format": "m4a-aac-lc",
      "sampleRate": 48000,
      "channelCount": 1,
      "bitsPerSample": 0,
      "aacPresentationFrameDelta": 0,
      "timelineStartMs": 0,
      "timelineAligned": true,
      "asrInput": false
    }
  ],
  "forbiddenFields": [
    "rawAudio",
    "transcriptText",
    "meetingContent",
    "credentials",
    "tokens",
    "signedUrls",
    "password",
    "apiKey",
    "mediaScribeCredentials",
    "langfuseContentTrace"
  ]
}
