      "forbiddenFields": ["rawAudio", "audioSnippet", "transcriptText", "credentials", "tokens", "signedUrls", "meetingContent"]
    },
    {
      "name": "live_passthrough.browser_validated",
      "requiredFields": ["targetName", "selectedMicrophone", "selectedSpeaker", "status", "failureReason"],
