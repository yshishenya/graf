{
  "schemaVersion": "browser-target-evidence.v1",
  "requiredTargets": [
    "chrome",
    "firefox",
    "opera",
    "yandex_browser"
  ],
  "requiredFields": [
    "target",
    "browserBundleID",
    "serviceFamily",
    "hostCategory",
    "patternClass",
    "pageState",
    "metadataAvailable",
    "calendarOrJoinIntentPresent",
    "failureReason",
    "checkedAt"
  ],
  "forbiddenFields": [
    "rawAudio",
    "audioSnippet",
    "transcriptText",
    "credentials",
    "tokens",
    "signedUrls",
    "meetingContent"
  ],
  "decisionRules": {
    "metadataUnavailableIsManualOnly": true,
    "joinedPageRequiresCalendarOrJoinIntent": true,
    "unsupportedMetadataIsManualOnly": true
  }
}
