{
  "schema": "2brain.rec.route_recovery_evidence.v1",
  "triggers": [
    "physical_input_change",
    "physical_output_change",
    "aggregate_or_multi_output_route",
    "bluetooth_route",
    "stale_browser_device_id",
    "coreaudiod_restart",
    "sleep_wake"
  ],
  "requiredFields": [
    "trigger",
    "detected_within_seconds",
    "expected_state",
    "actual_state",
    "recovery_action",
    "result"
  ],
  "allowedState": ["ready", "active", "stale", "degraded", "failed", "blocked", "repair", "recheck"],
  "allowedResult": ["passed", "blocked", "not_accepted"],
  "thresholds": {
    "route_transition_within_seconds": 5
  },
  "forbiddenFields": [
    "rawAudio",
    "audioSnippet",
    "transcriptText",
    "meetingContent",
    "credentials",
    "tokens",
    "signedUrls"
  ]
}
