{
  "schema": "local-recording-manifest.v5",
  "requiredFields": [
    "sessionId",
    "createdAt",
    "startedAt",
    "stoppedAt",
    "finalizedAt",
    "status",
    "directoryId",
    "manifestFileName",
    "transcriptionReadiness",
    "mediaScribeSourceMode",
    "canonicalMixProfile",
    "tracks",
    "externalEgressStarted",
    "transcriptionStarted",
    "diagnosticSafe",
    "localDeletionRegistered",
    "leakageFinalization",
    "failureReason",
    "durationDifferenceSeconds",
    "scopeApproval",
    "permissions",
    "captureHealth"
  ],
  "requiredTrackRoles": [
    "mixed_meeting_audio",
    "review_playback"
  ],
  "allowedStatuses": [
    "saved",
    "degraded",
    "blocked",
    "failed"
  ],
  "allowedReadinessStates": [
    "ready",
    "degraded",
    "failed"
  ],
  "requiredTrackFields": [
    "mediaScribeField",
    "sourceKind",
    "evidenceRole",
    "format",
    "sampleRate",
    "channelCount",
    "bitsPerSample",
    "timelineStartMs",
    "timelineAligned",
    "sha256",
    "failureReason"
  ],
  "forbiddenFields": [
    "rawAudio",
    "audioSnippet",
    "transcriptText",
    "meetingContent",
    "credentials",
    "apiKey",
    "tokens",
    "signedUrls",
    "password",
    "absolutePath",
    "liveSecretPath"
  ],
  "forbiddenExternalActivity": [
    "upload",
    "mediascribe",
    "langfuse",
    "dashboard_publish"
  ]
}
