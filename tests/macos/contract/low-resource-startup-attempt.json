{
  "schema": "2brain.rec.low_resource_startup_attempt.v1",
  "requiredFields": [
    "attempt_id",
    "trigger",
    "started_at",
    "completed_at",
    "duration_ms",
    "outcome",
    "blocked_reason",
    "fallback_used"
  ],
  "allowedTriggers": [
    "client_io_opened",
    "retry",
    "recovery",
    "manual_check",
    "test_fixture"
  ],
  "allowedOutcomes": ["ready", "blocked", "failed", "fallback"],
  "thresholds": {
    "maximum_duration_ms": 3000
  },
  "rules": {
    "mustCompleteWithinThreshold": true,
    "mustNotRunOnUnboundedUiMainPath": true,
    "blockedFailedFallbackAreValidTerminalOutcomes": true,
    "metadataOnly": true
  },
  "forbiddenFields": [
    "rawAudio",
    "audioSnippet",
    "transcriptText",
    "meetingContent",
    "credentials",
    "tokens",
    "signedUrls",
    "password"
  ]
}
