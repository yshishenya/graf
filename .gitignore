.DS_Store
*.log
*.tmp
*.swp

# Local secrets and environment overrides
.env
.env.*
!.env.example
secrets/
infra/secrets
infra/secrets/
*.key
*.pem
*.crt

# Local recording artifacts. Real audio and transcript-bearing captures are
# never source fixtures or implementation evidence.
*.wav
*.m4a
*.aac
*.caf
*.aiff
*.flac
*.mp3
*.pcm
test-rec/

# Common build/cache outputs
node_modules/
dist/
build/
coverage/
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Docker/local service data
backups/
docker-data/
minio-data/
postgres-data/
infra/runtime/
/twobrain-rec-deploy.lock

# Swift / Xcode local outputs
.build/
DerivedData/
*.swiftpm/
Packages/
*.xcuserstate
xcuserdata/

# Disposable release-signing fixtures. These may exercise temporary public
# manifests and runner-like files, but are never source, evidence, or keys.
apps/macos/.release-signing-fixtures/

# C / C++ local outputs
bin/
obj/
out/
*.o
*.a
!apps/macos/Vendor/GrafAEC3.xcframework/macos-arm64_x86_64/libGrafAEC3.a
*.so
*.dylib
*.prof*
*.dSYM/

# Local editor metadata
.idea/
.vscode/

# Spec Kit local runtime state that should not contain project source
.specify/feature.json

# Spec Kit/Codex generated working files
.specify/extensions/.registry
.specify/integrations/codex.manifest.json
.specify/scripts/bash/check-prerequisites.sh
.specify/scripts/bash/common.sh
.specify/scripts/bash/create-new-feature.sh
.specify/scripts/bash/setup-plan.sh
.specify/scripts/bash/setup-tasks.sh
.specify/workflows/workflow-registry.json

# Spec Kit workflow run logs
.specify/workflows/runs/

# Local brainstorming companion runtime
.superpowers/

# Private reference captures supplied during product audits. These may contain
# real account names, meeting titles, transcripts, local paths, or screenshots.
specs/**/reference/private-appshots/
docs/evidence/**/private-appshots/
.playwright-cli/
